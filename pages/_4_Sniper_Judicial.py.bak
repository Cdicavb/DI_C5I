import os
import time
import json
import pandas as pd
# from selenium import webdriver
from selenium.webdriver.chrome.options import Options
from selenium.webdriver.common.by import By
# import ollama

# --- CONFIGURACIÓN DEL PERFIL BUNKER ---
CHROME_BUNKER_PATH = "/Users/cris/Documents/Sistema_Inteligencia/Perfil_Bot"

def configurar_navegador():
    chrome_options = Options()
    chrome_options.add_argument(f"user-data-dir={CHROME_BUNKER_PATH}")
    chrome_options.add_argument("--remote-allow-origins=*")
    chrome_options.add_experimental_option("excludeSwitches", ["enable-automation"])
    driver = webdriver.Chrome(options=chrome_options)
    return driver

def procesar_con_qwen(texto_pantalla):
    """Qwen analiza todo el texto legal que estés viendo en la pantalla."""
    prompt_sistema = """
    Eres un Analista de Inteligencia. Analiza el texto extraído de la pantalla del Poder Judicial chileno.
    Extrae la información y entrégala ÚNICAMENTE en JSON con:
    - "rol_causa": El RIT o Rol principal encontrado (ej. C-17805-2024).
    - "tribunal": Juzgado o corte detectada (ej. 11° Juzgado Civil de Santiago).
    - "entidades": Lista de nombres de personas, RUTs y empresas.
    - "hitos_relevantes": Resumen del caso o las resoluciones.
    - "resumen_inteligencia": Explicación simple en 2 o 3 líneas.
    - "categoria": Inteligencia Criminal, Civil, Laboral o Reputacional.
    - "nivel_riesgo": CRÍTICO, ALTO, MEDIO o BAJO.
    
    Texto de la pantalla:
    """
    try:
        response = ollama.chat(model='qwen2.5:14b', messages=[
            {'role': 'system', 'content': prompt_sistema},
            {'role': 'user', 'content': texto_pantalla}
        ])
        respuesta = response['message']['content'].strip()
        if "```json" in respuesta:
            respuesta = respuesta.split("```json")[1].split("```")[0].strip()
        return json.loads(respuesta)
    except Exception as e:
        print(f"[!] Error de Qwen en el análisis PLN: {e}")
        return None

def ejecutar_modo_francotirador():
    print("[*] Levantando navegador táctico en Perfil Bunker...")
    driver = configurar_navegador()
    
    # Abrir la URL correcta
    protocolo = "https://"
    dominio = "oficinajudicialvirtual.pjud.cl/indexN.php"
    driver.get(protocolo + dominio)
    
    print("\n" + "="*60)
    print("🎯 MODO FRANCOTIRADOR ACTIVADO")
    print("="*60)
    print("1. Usa la ventana de Chrome para buscar manualmente por RIT, Nombre o RUT.")
    print("2. Abre el caso o deja los resultados en pantalla.")
    print("3. Vuelve a esta Terminal y presiona ENTER para extraer y analizar.")
    print("4. Repite el proceso todas las veces que quieras.")
    print("5. Escribe 'salir' y presiona ENTER cuando quieras terminar.")
    print("="*60)
    
    while True:
        comando = input("\n⚠️ Esperando objetivo... (Presiona ENTER para extraer o escribe 'salir'): ")
        
        if comando.lower() == 'salir':
            print("[*] Cerrando operación y guardando datos...")
            break
            
        try:
            print("[-] Extrayendo datos de la pantalla actual...")
            # Extraer todo el texto visible
            texto_pantalla = driver.find_element(By.TAG_NAME, "body").text
            
            if len(texto_pantalla) < 50:
                print("[!] No hay datos suficientes en la pantalla. Abre un caso e intenta de nuevo.")
                continue
                
            print("[+] Enviando la evidencia a Qwen 2.5 14B...")
            resultado = procesar_con_qwen(texto_pantalla)
            
            if resultado:
                resultado['fuente'] = 'pjud.cl'
                resultado['fecha_extraccion'] = time.strftime("%Y-%m-%d %H:%M")
                
                # Guardar inmediatamente en CSV
                df_nuevo = pd.DataFrame([resultado])
                try:
                    df_existente = pd.read_csv("db_inteligencia.csv")
                    df_final = pd.concat([df_existente, df_nuevo], ignore_index=True)
                except FileNotFoundError:
                    df_final = df_nuevo
                    
                df_final.to_csv("db_inteligencia.csv", index=False)
                
                print(f"✅ ¡ÉXITO! Caso {resultado.get('rol_causa', 'N/A')} capturado, analizado y guardado en la Base de Datos.")
            
        except Exception as e:
            print(f"[!] Error al extraer la pantalla: {e}")
            
    driver.quit()

if __name__ == "__main__":
    ejecutar_modo_francotirador()
